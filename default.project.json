          "$path": "src/StarterPlayer/StarterPlayerScripts"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "FightingClasses": {
        "$path": "src/StarterGui"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "FightingClasses": {
        "$path": "src/Workspace"
      }
    }
  }
